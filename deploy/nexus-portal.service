# systemd unit for the NEXUS display portal.
# Install (as root, assuming the repo is cloned at /opt/nexus):
#   cp /opt/nexus/deploy/nexus-portal.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now nexus-portal
[Unit]
Description=NEXUS display control portal
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/nexus/portal/server.py --port 8484
WorkingDirectory=/opt/nexus/portal
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
